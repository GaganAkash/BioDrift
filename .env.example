# Web console login (session cookie). Always set both to change.
BIODRIFT_USERNAME=admin
BIODRIFT_PASSWORD=biodrift
BIODRIFT_SESSION_SECRET=change-me-to-a-long-random-string

# Optional: lock the /api surface behind a bearer token too. With
# BIODRIFT_API_TOKEN set and ALLOW_ANON_GET=0, every write and every
# read-through the API requires `Authorization: Bearer <token>`.
BIODRIFT_API_TOKEN=
BIODRIFT_ALLOW_ANON_GET=1

# Web server
WEB_HOST=0.0.0.0
WEB_PORT=8000
